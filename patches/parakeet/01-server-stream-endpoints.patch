+// ---- streaming session registry --------------------------------------------
+// One entry per live /v1/stream session. Feeds on one session serialize on the
+// per-session mutex; different sessions need no app-level lock — the library
+// serializes computes on its internal backend mutex. The registry mutex only
+// guards the map. Sessions are held by shared_ptr so a reap/finalize/delete
+// can erase the map entry while a feed is in flight: the feed's shared_ptr
+// keeps the Sess alive until its handler returns.
+struct StreamSess {
+    parakeet_stream* stream = nullptr;  // nulled once freed
+    std::mutex mu;                      // serializes feed/finalize/free on this session
+    std::chrono::steady_clock::time_point last_used;
+    size_t total_samples = 0;
+};
+
+constexpr size_t kMaxStreamSessions  = 8;
+constexpr size_t kMaxSessionSamples  = 16000u * 600u;  // 10 minutes @ 16 kHz
+constexpr size_t kMaxFeedSamples     = 16000u * 30u;   // 30 s cap per /audio feed
+constexpr int    kSessionIdleReapSec = 120;
+
