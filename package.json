{
  "name": "dottie-talk",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Local parakeet STT + koko TTS via MCP and HTTP — standalone, no gateway hop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevederico/dottie-talk.git"
  },
  "bugs": {
    "url": "https://github.com/stevederico/dottie-talk/issues"
  },
  "homepage": "https://github.com/stevederico/dottie-talk#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./core.js",
    "./core.js": "./core.js",
    "./http.js": "./http.js",
    "./mcp.js": "./mcp.js",
    "./ports.js": "./ports.js"
  },
  "bin": {
    "dottie-talk": "./mcp.js"
  },
  "scripts": {
    "setup": "npm install && npm run install:bins",
    "mcp": "node mcp.js",
    "http": "DOTTIE_TALK_HTTP_PORT=1320 node http.js",
    "install:bins": "bash scripts/install_bins.sh",
    "test": "node --test core.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
