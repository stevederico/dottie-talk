{
  "name": "dottie-talk",
  "version": "0.3.1",
  "license": "MIT",
  "type": "module",
  "description": "Local parakeet STT + koko TTS via MCP and HTTP — standalone, no gateway hop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevederico/dottie-talk.git"
  },
  "bugs": {
    "url": "https://github.com/stevederico/dottie-talk/issues"
  },
  "homepage": "https://github.com/stevederico/dottie-talk#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": "./core.js",
    "./core.js": "./core.js",
    "./http.js": "./http.js",
    "./mcp.js": "./mcp.js",
    "./ports.js": "./ports.js"
  },
  "bin": {
    "dottie-talk": "./http.js"
  },
  "scripts": {
    "postinstall": "node -e \"import('node:fs').then(fs=>{for (const f of ['parakeet-server','koko']) {const p='bin/'+f; try{fs.chmodSync(p,0o755)}catch{}}})\"",
    "start": "node http.js",
    "mcp": "node mcp.js",
    "http": "node http.js",
    "tts": "node ensure-tts.js",
    "install:bins": "bash scripts/install_bins.sh",
    "test": "node --test core.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
